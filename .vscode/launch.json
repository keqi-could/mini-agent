{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py（可在 Agent.chat 里打断点）",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "Python: agent_class.py（命令行看多轮记忆）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent_class.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
